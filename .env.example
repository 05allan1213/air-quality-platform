# Generate the three secrets locally before running Compose (see README).
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=air_quality
POSTGRES_USER=air_local
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
WEB_PORT=8000
# Local loopback HTTP: 0. Use 1 when serving over HTTPS.
COOKIE_SECURE=0
# Optional compose.cnemc.yaml overlay. The base Compose has internal-only Worker networking.
CNEMC_MODE=off
# Compose derives the Worker network name (<project>_cnemc-egress) automatically.
# First A03: cnemc-a03-once_cnemc-egress (docs/operations/CNEMC.md).

# Dedicated offline Compose Beat. Set both for registered instances only.
# AQ_INSTANCE_ID=
# AQ_BEAT_LOCK_SOURCE=

# Optional compose.host-infra.yaml (sole -f file, separate project). Supply a
# separate --env-file for Compose. Set these vars along with the database vars.
# AQ_HOST_ROOT=
# AQ_HOST_UID=
# AQ_HOST_GID=

# Host launcher uses its own 0600 backend.env, never this Compose file.
# See docs/operations/S07.md for settings, preparation and checks.
