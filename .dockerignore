# Build context: application source, local licenses and locked inputs only.
**
!Dockerfile
!pyproject.toml
!uv.lock
!.python-version
!main.py
!backend/**/*.py
!backend/accounts/templates/admin/*.html
!backend/samples/data/co-hour-v1.json
!tests/**/*.py
!scripts/*.py
!scripts/s03_compose.yaml
!scripts/s07_isolation.yaml
!scripts/s07_offline_dns.yaml
!docs/api/openapi.v1.json
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/src/**/*.vue
!frontend/src/**/*.ts
!frontend/src/**/*.css
!frontend/public/licenses/index.md
!frontend/public/licenses/fonts/*-OFL.txt
!frontend/public/licenses/packages/*-MIT.txt
!frontend/public/licenses/packages/*-Apache-2.0.txt
**/.env*
**/__pycache__/
**/node_modules/
**/dist/
